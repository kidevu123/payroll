{
  "$comment": "Verified from UI screenshots 2026-05-30. View Attendance Punch lives under Report at /att/timecard/transaction; Mend Attendance Punch under Attendance at /att/timecard/manual-log. Prefer navigation.*Url deep links over sidebar label clicks — route paths survive copy changes. Punch grid cells still expose stable data-field attributes. DO NOT switch back to Element Plus selectors.",
  "login": {
    "url": "/user/login",
    "username": "input[name='username'], input[placeholder='Email'], input[type='email'], input[name*='email' i], input[name*='user' i]",
    "password": "input[name='password'], input[type='password'], input[placeholder='Password']",
    "agreementCheckbox": "label:has-text(\"have read\") input[type=\"checkbox\"], label:has-text(\"USER AGREEMENT\") input[type=\"checkbox\"], label:has-text(\"PRIVACY POLICY\") input[type=\"checkbox\"]",
    "agreementClickTarget": "label:has-text(\"have read\"), label:has-text(\"USER AGREEMENT\"), label:has-text(\"PRIVACY POLICY\")",
    "submit": "button:has-text(\"Login\")",
    "loggedInLandmark": "text=\"Quickly Setting\", text=\"Dashboard\", text=\"Attendance\", text=\"Report\""
  },
  "navigation": {
    "viewAttendancePunchUrl": "/att/timecard/transaction",
    "mendAttendancePunchUrl": "/att/timecard/manual-log",
    "attendanceReportUrl": "/att/timecard/timecard",
    "reportsLink": "text=/Reports?/i",
    "punchReportLink": "text=/Punch.*Report|Attendance Report|Timecard Management/i",
    "reportMenu": "text=/^Report$/i",
    "attendanceMenu": "text=/^Attendance$/i",
    "viewAttendancePunchLink": ":text-is(\"View Attendance Punch\")",
    "mendAttendancePunchLink": ":text-is(\"Mend Attendance Punch\")"
  },
  "report": {
    "fromDate": "input[name='fromDate'], input[type='date']:nth-of-type(1)",
    "toDate": "input[name='toDate'], input[type='date']:nth-of-type(2)",
    "applyButton": "button:has-text('Apply'), button:has-text('Search'), button:has-text('Run')",
    "exportCsvButton": "button:has-text('Export CSV'), a:has-text('Export CSV')"
  },
  "viewPunch": {
    "tableLandmark": "[role=\"row\"][aria-rowindex=\"1\"]",
    "rowsContainer": ".MuiDataGrid-row",
    "personNameCell": "[role=\"cell\"][data-field=\"employee_name\"]",
    "personIdCell": "[role=\"cell\"][data-field=\"employee_code\"]",
    "punchDateCell": "[role=\"cell\"][data-field=\"att_date\"]",
    "punchTimeCell": "[role=\"cell\"][data-field=\"attendance_status\"]",
    "verifyTypeCell": "[role=\"cell\"][data-field=\"verify_type\"]",
    "timezoneCell": "[role=\"cell\"][data-field=\"timezone\"]",
    "sourceCell": "[role=\"cell\"][data-field=\"punch_from\"]",
    "nextPageButton": "button[aria-label=\"Go to next page\"]:not([disabled])",
    "pageInfo": ".MuiTablePagination-displayedRows",
    "showMendedRecordsToggle": "label:has-text(\"Show mended records\"), :text-is(\"Show mended records\")"
  },
  "challenge": {
    "twoFactorLandmark": "text=/Two[- ]Factor|2FA|Verification Code/i",
    "captchaLandmark": "iframe[src*='captcha'], [data-captcha]"
  }
}
