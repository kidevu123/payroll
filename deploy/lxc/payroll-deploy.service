[Unit]
Description=Pull payroll repo and re-up the docker compose stack
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# A full `docker compose --build` (next build + typecheck) runs 2-3 minutes.
# Without this, the unit inherits DefaultTimeoutStartSec (90s) and systemd
# SIGTERMs the build mid-typecheck — which is exactly what silently bricked
# auto-deploy for days. Bound it generously (30 min) rather than `infinity`
# so a genuinely hung build still gets reaped instead of orphaning.
TimeoutStartSec=1800
# These are filled in by the install.sh override.conf:
Environment=PAYROLL_DIR=/opt/payroll
Environment=PAYROLL_BRANCH=rebuild/foundation
WorkingDirectory=/opt/payroll
# Pull, then rebuild iff (a) git HEAD changed OR (b) the running
# container's stamped /app/.git-sha doesn't match git HEAD. The second
# condition catches the historical silent-fail trap: a build error left
# the timer thinking "no changes" forever even though the container was
# stale.
# Before a rebuild the current image is tagged payroll-app:previous, so a
# rollback is a retag + restart (see docs/runbook.md "Roll back a deploy")
# instead of another full build. After a successful rebuild, dangling
# images and dangling build cache are removed. Left alone, the cache grew
# by gigabytes per deploy until builds failed with "no space left on
# device". Only DANGLING cache goes: the live cache (the layers of the
# current image, ~2-3 GB) is what makes a routine deploy a 2-minute cached
# build instead of a 15-minute cold one. A hard size cap was tried and
# rejected: Docker's --max-used-space refuses to prune below the live set,
# so it reclaimed nothing. Both cleanups are best-effort and can never
# fail the deploy.
ExecStart=/bin/bash -c '\
  set -euo pipefail; \
  cd "$PAYROLL_DIR"; \
  git fetch --quiet origin "$PAYROLL_BRANCH"; \
  before=$(git rev-parse HEAD); \
  git reset --hard --quiet "origin/$PAYROLL_BRANCH"; \
  after=$(git rev-parse HEAD); \
  export BUILD_GIT_SHA="$after"; \
  export BUILD_GIT_BRANCH="$PAYROLL_BRANCH"; \
  running=$(/usr/bin/docker compose exec -T app cat /app/.git-sha 2>/dev/null | tr -d "[:space:]" || true); \
  /usr/bin/docker ps -aq --filter status=exited --filter status=created --filter label=com.docker.compose.project=payroll | xargs -r /usr/bin/docker rm -f >/dev/null 2>&1 || true; \
  if [ "$before" != "$after" ]; then \
    echo "deploying $before -> $after"; \
    /usr/bin/docker tag payroll-app:latest payroll-app:previous 2>/dev/null || true; \
    /usr/bin/docker compose up -d --build --remove-orphans; \
    /usr/bin/docker image prune -f >/dev/null 2>&1 || true; \
    /usr/bin/docker builder prune -f >/dev/null 2>&1 || true; \
  elif [ -n "$running" ] && [ "$running" != "$after" ]; then \
    echo "container drift detected (running=$running, head=$after) — rebuilding"; \
    /usr/bin/docker tag payroll-app:latest payroll-app:previous 2>/dev/null || true; \
    /usr/bin/docker compose up -d --build --remove-orphans; \
    /usr/bin/docker image prune -f >/dev/null 2>&1 || true; \
    /usr/bin/docker builder prune -f >/dev/null 2>&1 || true; \
  else \
    echo "no changes ($after); ensuring services are up"; \
    /usr/bin/docker compose up -d --remove-orphans; \
  fi'

[Install]
WantedBy=multi-user.target
